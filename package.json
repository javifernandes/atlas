{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/javifernandes/atlas.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/verify-atlas-source-traces.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/atlas-postgres.ts migrate",
    "db:verify": "node --env-file-if-exists=.env.local --import tsx scripts/atlas-postgres.ts verify",
    "db:reconcile": "node --env-file-if-exists=.env.local --import tsx scripts/atlas-reconcile.ts",
    "db:rebuild": "node --env-file-if-exists=.env.local --import tsx scripts/atlas-reconcile.ts rebuild",
    "start": "next start",
    "test": "vitest run",
    "test:postgres": "ATLAS_POSTGRES_TEST_ENABLED=1 vitest run src/atlas/persistence/postgres-application.integration.test.ts",
    "test:postgres:neon": "node scripts/test-postgres-neon.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm test && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@neon/config": "^1.2.0",
    "@neon/env": "^1.2.0",
    "@ontahi/core": "1.0.0-alpha.11",
    "@ontahi/postgres": "1.0.0-alpha.11",
    "@ontahi/runtime-nextjs": "1.0.0-alpha.11",
    "clsx": "^2.1.1",
    "effect": "3.21.0",
    "lucide-react": "^0.576.0",
    "mermaid": "^11.15.0",
    "next": "^14.2.0",
    "pg": "8.16.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "shiki": "^1.6.0",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "11.7.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.0.0",
    "@types/pg": "8.15.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.27",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.0",
    "testcontainers": "11.7.2",
    "tsx": "4.20.6",
    "typescript": "^5.4.0",
    "vitest": "4.0.18"
  },
  "packageManager": "pnpm@10.28.2"
}
