{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/javifernandes/atlas.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/verify-atlas-source-traces.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/atlas-postgres.ts migrate",
    "db:backfill:workspaces": "node --env-file-if-exists=.env.local --import tsx scripts/atlas-workspace-backfill.ts",
    "db:traffic": "node --env-file-if-exists=.env.local --import tsx scripts/atlas-postgres-traffic.ts",
    "db:verify": "node --env-file-if-exists=.env.local --import tsx scripts/atlas-postgres.ts verify",
    "db:catch-up": "node --env-file-if-exists=.env.local --import tsx scripts/atlas-catch-up.ts",
    "db:reconcile": "node --env-file-if-exists=.env.local --import tsx scripts/atlas-reconcile.ts",
    "db:reconcile:workspace": "node --env-file-if-exists=.env.local --import tsx scripts/atlas-workspace-reconcile.ts",
    "db:rebuild": "node --env-file-if-exists=.env.local --import tsx scripts/atlas-reconcile.ts rebuild",
    "dev:seed:invitation-candidate": "node --env-file-if-exists=.env.local --import tsx scripts/atlas-dev-invitation-fixture.ts seed",
    "dev:cleanup:invitation-candidate": "node --env-file-if-exists=.env.local --import tsx scripts/atlas-dev-invitation-fixture.ts cleanup",
    "dev:seed:invitation-recipient": "node --env-file-if-exists=.env.local --import tsx scripts/atlas-dev-invitation-fixture.ts seed-recipient",
    "dev:cleanup:invitation-recipient": "node --env-file-if-exists=.env.local --import tsx scripts/atlas-dev-invitation-fixture.ts cleanup-recipient",
    "start": "next start",
    "test": "vitest run",
    "test:postgres": "ATLAS_POSTGRES_TEST_ENABLED=1 vitest run src/atlas/persistence/postgres-application.integration.test.ts",
    "test:postgres:neon": "node scripts/test-postgres-neon.mjs",
    "typecheck": "tsc --noEmit",
    "check:text-format": "node scripts/check-text-format.mjs",
    "check:pr-context": "node scripts/check-atlas-pr-context.mjs",
    "verify": "pnpm check:text-format && pnpm test && pnpm typecheck && pnpm build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@neon/config": "^1.2.0",
    "@neon/env": "^1.2.0",
    "@ontahi/core": "1.0.0-alpha.26",
    "@ontahi/devtools": "1.0.0-alpha.26",
    "@ontahi/postgres": "1.0.0-alpha.26",
    "@ontahi/react": "1.0.0-alpha.26",
    "@ontahi/runtime-nextjs": "1.0.0-alpha.26",
    "@tanstack/react-query": "^5.102.8",
    "better-auth": "1.7.2",
    "clsx": "^2.1.1",
    "effect": "3.21.0",
    "elkjs": "^0.12.1",
    "lucide-react": "^0.576.0",
    "mermaid": "^11.15.0",
    "next": "^14.2.0",
    "pg": "8.16.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "shiki": "^1.6.0",
    "tailwind-merge": "^2.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "11.7.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.0.0",
    "@types/pg": "8.15.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.27",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.0",
    "testcontainers": "11.7.2",
    "tsx": "4.20.6",
    "typescript": "^5.4.0",
    "vitest": "4.0.18",
    "storybook": "^10.6.8",
    "@storybook/nextjs-vite": "^10.6.8",
    "vite": "latest"
  },
  "packageManager": "pnpm@10.28.2"
}
