ATLAS_GITHUB_APP_ID=
ATLAS_GITHUB_APP_PRIVATE_KEY_BASE64=
ATLAS_GITHUB_APP_WEBHOOK_SECRET=
ATLAS_GITHUB_REPOSITORY=javifernandes/atlas
ATLAS_GITHUB_REF=main

# Leave unset for environment defaults; set memory only as an explicit production rollback.
ATLAS_STORAGE_MODE=
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional local fallback when GitHub App credentials are unavailable.
ATLAS_GITHUB_TOKEN=

# Human login reuses the GitHub App above through its OAuth client ID and client secret.
# These are distinct from the numeric App ID, private key, and webhook secret.
ATLAS_AUTH_GITHUB_CLIENT_ID=
ATLAS_AUTH_GITHUB_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The viewer is public by default. Private mode requires auth plus an allowlist until workspace
# ownership is persisted. Values in the allowlist are comma-separated stable GitHub numeric IDs.
ATLAS_VISIBILITY=public
ATLAS_PRIVATE_GITHUB_USER_IDS=
